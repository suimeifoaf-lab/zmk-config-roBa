#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

#define MOUSE 4
#define SCROLL 5

&mt {
    flavor = "balanced";
    quick-tap-ms = <300>;
};

&lt {
    flavor = "balanced";
    quick-tap-ms = <300>;
};

&mkp_input_listener {
    input-processors = <&zip_temp_layer 4 250>;
};

/ {
    combos {
        compatible = "zmk,combos";
    };

    behaviors {
        encoder_msc_down_up: encoder_msc_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <20>;
        };

        tog_off: toggle_layer_off {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer Off";
            toggle-mode = "off";
        };

        mt_exit_AML_on_tap: mt_exit_AML_on_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_EXIT_AML_ON_TAP";
            bindings = <&kp>, <&kp_exit_AML>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            quick-tap-ms = <300>;
        };

        lt_exit_AML_on_tap: lt_exit_AML_on_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_EXIT_AML_ON_TAP";
            bindings = <&mo>, <&kp_exit_AML>;
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "balanced";
            quick-tap-ms = <300>;
        };

        lt_shift_exit_AML_on_tap: lt_shift_exit_AML_on_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_SHIFT_EXIT_AML_ON_TAP";
            bindings = <&kp>, <&kp_exit_AML>;
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "balanced";
            quick-tap-ms = <300>;
        };
    };

    macros {
        exit_AML: exit_AML {
            compatible = "zmk,behavior-macro";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <0>;
            bindings = <&tog_off MOUSE>;
            label = "EXIT_AML";
        };

        kp_exit_AML: kp_exit_AML {
            compatible = "zmk,behavior-macro-one-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <1>;
            bindings = <&macro_param_1to1 &kp MACRO_PLACEHOLDER &exit_AML>;
            label = "KP_EXIT_AML";
        };

        ss_mac: ss_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI &kp LSHFT>
                , <&macro_tap &kp N5>
                , <&macro_release &kp LGUI &kp LSHFT>;
            label = "SS_MAC";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = 
&kp Q      &kp W         &kp E         &kp R                                 &kp T                                                                              &kp Y         &kp U                           &kp I      &kp O    &kp P
&kp A      &kp S         &kp D         &mt_exit_AML_on_tap LEFT_WIN F        &kp G  &trans                          &kp MINUS                                  &kp H         &mt_exit_AML_on_tap LEFT_WIN J  &kp K      &kp L    &kp SEMI
&kp Z      &kp X         &kp C         &kp V                                 &kp B  &trans                          &trans                                     &kp N         &kp M                           &kp COMMA  &kp DOT  &kp LS(INT1)
&kp LCTRL  &kp LEFT_ALT  &kp LEFT_WIN  &mt_exit_AML_on_tap LEFT_SHIFT LANG2  &lt_exit_AML_on_tap 1 SPACE  &lt_shift_exit_AML_on_tap LEFT_SHIFT LANG1  &kp BACKSPACE  &lt 3 ENTER  &ss_mac
            >;
            sensor-bindings = <&encoder_msc_down_up>;
        };

        SYMBOL {
            bindings = 
&kp PRCNT  &kp DLLR   &kp UP     &kp CARET  &kp FSLH                        &kp BSLH  &kp LBRC  &kp RBRC  &kp LT   &kp GT
&kp AT     &kp LEFT   &kp DOWN   &kp RIGHT  &kp EQUAL  &trans  &trans       &kp UNDER &kp LPAR  &kp RPAR  &kp SEMI &kp COLON
&kp GRAVE  &kp TILDE  &kp MINUS  &kp EXCL   &kp QMARK  &trans  &trans       &kp PIPE  &kp LBKT  &kp RBKT  &kp SQT  &kp DQT
&trans     &trans     &trans     &trans     &trans     &trans  &kp COMMA    &kp DOT                              &kp ESC
            >;
            sensor-bindings = <&encoder_msc_down_up>;
        };

        NUM {
            bindings = 
&trans  &kp F9  &kp F10  &kp F11  &kp F12                    &kp N7  &kp N8  &kp N9  &kp PLUS  &kp MINUS
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &trans  &trans    &kp N4  &kp N5  &kp N6  &kp STAR  &kp SLASH
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &trans  &trans    &kp N1  &kp N2  &kp N3  &kp RBRC  &kp COLON
&trans  &trans  &trans   &trans   &trans   &trans  &trans    &kp N0                              &kp DOT
            >;
            sensor-bindings = <&encoder_msc_down_up>;
        };

        ARROW {
            bindings = 
&kp ESC         &kp N7  &kp N8  &kp N9  &kp STAR                        &kp LPAR              &kp LA(LEFT)  &kp UP    &kp RA(RIGHT)  &kp LBKT
&kp TAB         &kp N4  &kp N5  &kp N6  &kp RBKT  &trans  &trans        &kp BSLH              &kp EXCL      &kp MINUS &kp QMARK      &kp RC(TAB)
&kp LEFT_SHIFT  &kp N1  &kp N2  &kp N3  &trans    &trans  &trans        &kp LA(LG(LC(LEFT)))  &kp LEFT      &kp UP    &kp RIGHT      &kp RA(RC(RG(RIGHT)))
&trans          &trans  &kp N0  &trans  &trans    &trans  &trans        &kp BACKSPACE                                               &trans
            >;
            sensor-bindings = <&encoder_msc_down_up>;
        };

        MOUSE {
            bindings = 
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &mkp MB1  &mkp MB3  &mkp MB2  &mo 5
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans                                &trans
            >;
            sensor-bindings = <&encoder_msc_down_up>;
        };

        SCROLL {
            bindings = 
&trans  &trans  &kp ENTER  &trans  &trans                                 &trans           &trans           &trans  &trans  &trans
&trans  &trans  &trans     &trans  &trans          &trans  &trans         &trans           &trans           &trans  &trans  &trans
&trans  &trans  &trans     &trans  &trans          &trans  &trans         &trans           &trans           &trans  &trans  &trans
&trans  &trans  &trans     &trans  &kp LS(LG(N5))  &kp LS(LG(N4))  &kp LC(DOWN)  &kp LC(UP_ARROW)                          &trans
            >;
            sensor-bindings = <&encoder_msc_down_up>;
        };

        CONFIG {
            bindings = 
&bt BT_CLR_ALL  &bt BT_CLR    &trans        &trans        &trans                              &trans       &trans  &trans  &trans  &trans
&trans          &trans        &trans        &trans        &trans        &trans  &trans        &trans       &trans  &trans  &trans  &trans
&bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans  &trans        &bootloader  &trans  &trans  &trans  &trans
&trans          &trans        &trans        &trans        &trans        &trans  &trans        &trans                               &trans
            >;
            sensor-bindings = <&encoder_msc_down_up>;
        };
    };
};
