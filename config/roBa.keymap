#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <300>;
};

&lt {
    flavor = "balanced";
    quick-tap-ms = <300>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;
};

/ {
    combos {
        compatible = "zmk,combos";
    };

    behaviors {
        enc_scroll: enc_scroll {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E         &kp R             &kp T                                                &kp Y            &kp U  &kp I      &kp O     &kp P
&kp A             &kp S         &kp D         &kp F             &kp G        &trans      &kp MINUS                 &kp H            &kp J  &kp K      &kp L     &kp SEMI
&kp Z             &kp X         &kp C         &kp V             &kp B        &trans      &trans                    &kp N            &kp M  &kp COMMA  &kp DOT   &kp SLASH
&kp LCTRL         &kp LEFT_ALT  &kp LEFT_WIN  &mt LEFT_SHIFT LANG2  &lt 1 SPACE  &lt 2 LANG1      &kp BACKSPACE  &lt 3 ENTER                             &lt 5 ESCAPE
            >;

            sensor-bindings = <&enc_scroll SCRL_UP SCRL_DOWN>;
        };

        SYMBOL {
            bindings = <
&kp PRCNT  &kp DLLR   &kp UP     &kp CARET  &kp FSLH                             &kp BSLH  &kp LBRC  &kp RBRC  &kp LT    &kp GT
&kp AT     &kp LEFT   &kp DOWN   &kp RIGHT  &kp EQUAL  &trans      &trans       &kp UNDER &kp LPAR  &kp RPAR  &kp SEMI  &kp COLON
&kp GRAVE  &kp TILDE  &kp MINUS  &kp EXCL   &kp QMARK  &trans      &trans       &kp PIPE  &kp LBKT  &kp RBKT  &kp SQT   &kp DQT
&trans     &trans     &trans     &trans     &trans     &trans      &kp COMMA    &kp DOT                               &kp ESC
            >;
        };

        NUM {
            bindings = <
&trans  &kp F9  &kp F10  &kp F11  &kp F12                      &kp N7  &kp N8  &kp N9  &kp PLUS  &kp MINUS
&trans  &kp F5  &kp F6   &kp F7   &kp F8    &trans  &trans    &kp N4  &kp N5  &kp N6  &kp STAR  &kp SLASH
&trans  &kp F1  &kp F2   &kp F3   &kp F4    &trans  &trans    &kp N1  &kp N2  &kp N3  &kp RBRC  &kp COLON
&trans  &trans  &trans   &trans   &trans    &trans  &trans    &kp N0                              &kp DOT
            >;
        };

        ARROW {
            bindings = <
&kp ESC        &kp N7  &kp N8   &kp N9   &kp STAR                     &kp LPAR                    &kp LA(LEFT)  &kp UP    &kp RA(RIGHT)              &kp LBKT
&kp TAB        &kp N4  &kp N5   &kp N6   &kp RBKT   &trans  &trans    &kp BSLH                    &kp EXCL      &kp MINUS &kp QMARK                  &kp RC(TAB)
&kp LEFT_SHIFT &kp N1  &kp N2   &kp N3   &trans     &trans  &trans    &kp LA(LG(LC(LEFT)))       &kp LEFT      &kp UP    &kp RIGHT                  &kp RA(RC(RG(RIGHT)))
&trans         &trans  &kp N0   &trans   &trans     &trans  &trans    &kp BACKSPACE                         &trans
            >;

            sensor-bindings = <&enc_scroll SCRL_UP SCRL_DOWN>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &mkp MB1  &mkp MB3  &mkp MB2  &mo 5
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans                                &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &kp ENTER  &trans  &trans                                     &trans            &trans        &trans           &trans  &trans
&trans  &trans  &trans     &trans  &trans     &trans  &trans                 &trans            &trans        &trans           &trans  &trans
&trans  &trans  &trans     &trans  &trans     &trans  &trans                 &trans            &trans        &trans           &trans  &trans
&trans  &trans  &trans     &trans  &kp LS(LG(N5))  &kp LS(LG(N4))      &kp LC(DOWN)  &kp LC(UP_ARROW)          &trans
            >;
        };

        CONFIG {
            bindings = <
&bt BT_CLR_ALL  &bt BT_CLR    &trans        &trans        &trans                            &trans       &trans  &trans  &trans  &trans
&trans          &trans        &trans        &trans        &trans        &trans  &trans    &trans       &trans  &trans  &trans  &trans
&bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans  &trans    &bootloader  &trans  &trans  &trans  &trans
&trans          &trans        &trans        &trans        &trans        &trans  &trans    &trans                               &trans
            >;
        };
    };
};
