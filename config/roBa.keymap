#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

/* レイヤー番号（keymap 内の並び順と一致させること） */
#define BASE       0
#define WIN        1   /* Windows 用の差し替え層（CONFIG の W でトグル）。SYMBOL/NUM/ARROW より下に置く（F/J 位置の記号・数字を食わないため） */
#define SYMBOL     2
#define NUM        3
#define ARROW      4
#define MOUSE      5   /* ボールを動かすと自動で入る（AML）。WIN より上（J のクリックが Ctrl/J に負けないため） */
#define SCROLL     6
#define CONFIG     7
#define WIN_ARROW  8   /* WIN + ARROW のとき自動で重なる（conditional layer） */
#define WIN_SCROLL 9   /* WIN + SCROLL のとき自動で重なる */

&mt {
    flavor = "balanced";
    quick-tap-ms = <300>;
};

&lt {
    flavor = "balanced";
    quick-tap-ms = <300>;
};

/* ボールを動かすと MOUSE 層へ（クリックするまで留まる）。roBa_R.overlay は層番号 4 を直書きしており
 * v5 では 4 = ARROW になるため、ここで定義名 MOUSE に上書きする（2026-10-27） */
&trackball_listener {
    input-processors = <&zip_temp_layer MOUSE 100000>;
};

/* ボールをスクロールに切り替える層。roBa_R.overlay は scroll-layers = <5> と直書きしており
 * v5 では 5 = MOUSE になる（ボールを動かすとスクロールしてしまう）ため、定義名 SCROLL に上書きする（2026-10-27） */
&trackball {
    scroll-layers = <SCROLL>;
};

/* クリック後250msでAML解除（マウスキーを押すまでレイヤーに留まる挙動） */
&mkp_input_listener {
    input-processors = <&zip_temp_layer MOUSE 250>;
};

/ {
    combos {
        compatible = "zmk,combos";
    };

    /* WIN 層が有効なときだけ、OS で送るキーが変わる層を重ねる */
    conditional_layers {
        compatible = "zmk,conditional-layers";

        win_arrow {
            if-layers = <ARROW WIN>;
            then-layer = <WIN_ARROW>;
        };

        win_scroll {
            if-layers = <SCROLL WIN>;
            then-layer = <WIN_SCROLL>;
        };
    };

    behaviors {
        /* エンコーダ: 既定は縦スクロール（時計回り=下） */
        encoder_msc_down_up: encoder_msc_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <20>;
        };

        /* エンコーダ: NUM 層では音量（時計回り=上げる） */
        encoder_volume: encoder_volume {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_VOLUME";
            #sensor-binding-cells = <0>;
            bindings = <&kp C_VOL_UP>, <&kp C_VOL_DN>;
        };

        /* レイヤーをオフにするbehavior */
        tog_off: toggle_layer_off {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer Off";
            toggle-mode = "off";
        };

        /* タップ時のみAML解除するmt（Shift/Winなどのモディファイア用） */
        mt_exit_AML_on_tap: mt_exit_AML_on_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_EXIT_AML_ON_TAP";
            bindings = <&kp>, <&kp_exit_AML>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            quick-tap-ms = <300>;
        };

        /* タップ時のみAML解除するlt（Space/LANG1などのレイヤータップ用） */
        lt_exit_AML_on_tap: lt_exit_AML_on_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_EXIT_AML_ON_TAP";
            bindings = <&mo>, <&kp_exit_AML>;
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "balanced";
            quick-tap-ms = <300>;
        };
    };

    macros {
        /* タップ時にAMLを解除するマクロ */
        exit_AML: exit_AML {
            compatible = "zmk,behavior-macro";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <0>;
            bindings = <&tog_off MOUSE>;
            label = "EXIT_AML";
        };

        kp_exit_AML: kp_exit_AML {
            compatible = "zmk,behavior-macro-one-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <1>;
            bindings = <&macro_param_1to1 &kp MACRO_PLACEHOLDER &exit_AML>;
            label = "KP_EXIT_AML";
        };

        /* Mac のスクリーンショット（Cmd+Shift+5） */
        ss_mac: ss_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI &kp LSHFT>
                , <&macro_tap &kp N5>
                , <&macro_release &kp LGUI &kp LSHFT>;
            label = "SS_MAC";
        };
    };

    /*
     * 物理配置（43キー）
     *   1段目: 左5 ／ 右5
     *   2段目: 左5＋内側1 ／ 内側1＋右5
     *   3段目: 左5＋内側1 ／ 内側1＋右5
     *   4段目: 左親指6（Ctrl Alt Win Shift Space かな）／ 右親指2（BS Enter）／ 右端1
     */
    keymap {
        compatible = "zmk,keymap";

        /* 0: Mac 用の文字層。内側4キーは Tab・Esc・-・Del */
        default_layer {
            display-name = "Mac";
            bindings = <
&kp Q      &kp W         &kp E         &kp R                                 &kp T                                                                              &kp Y          &kp U                           &kp I      &kp O     &kp P
&kp A      &kp S         &kp D         &mt_exit_AML_on_tap LEFT_WIN F        &kp G  &kp TAB                       &kp MINUS                                   &kp H          &mt_exit_AML_on_tap LEFT_WIN J  &kp K      &kp L     &kp SEMI
&kp Z      &kp X         &kp C         &kp V                                 &kp B  &kp ESC                       &kp DEL                                     &kp N          &kp M                           &kp COMMA  &kp DOT   &kp UNDER   
&kp LCTRL  &kp LEFT_ALT  &kp LEFT_WIN  &mt_exit_AML_on_tap LEFT_SHIFT LANG2  &lt_exit_AML_on_tap SYMBOL SPACE  &lt_exit_AML_on_tap NUM LANG1      &kp BACKSPACE  &lt ARROW ENTER                                                            &ss_mac
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        /* 1: Windows 用の差し替え（CONFIG の W でトグル・SYMBOL/NUM/ARROW より下）。ホームロウ F/J = Ctrl、親指列 Win/Alt/Ctrl、右端 = Win+Shift+S */
        win_layer {
            display-name = "Win";
            bindings = <
&trans        &trans        &trans     &trans                                &trans                                                   &trans  &trans                        &trans  &trans  &trans
&trans        &trans        &trans     &mt_exit_AML_on_tap LCTRL F           &trans  &trans                  &trans                   &trans  &mt_exit_AML_on_tap LCTRL J   &trans  &trans  &trans
&trans        &trans        &trans     &trans                                &trans  &trans                  &trans                   &trans  &trans                        &trans  &trans  &trans
&kp LEFT_WIN  &kp LEFT_ALT  &kp LCTRL  &trans                                &trans  &trans                  &trans                   &trans                                                &kp LG(LS(S))
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        /* 2: 記号（Space ホールド）。矢印は ARROW 層へ移し、空いた左手に & + * # を置いた */
        symbol_layer {
            display-name = "Sym";
            bindings = <
&kp PRCNT  &kp DLLR   &kp AMPS   &kp CARET  &kp FSLH                                 &kp BSLH   &kp LBRC  &kp RBRC  &kp LT    &kp GT
&kp AT     &kp PLUS   &kp STAR   &kp HASH   &kp EQUAL  &trans      &trans            &kp UNDER  &kp LPAR  &kp RPAR  &trans    &kp COLON
&kp GRAVE  &kp TILDE  &kp MINUS  &kp EXCL   &kp QMARK  &trans      &trans            &kp PIPE   &kp LBKT  &kp RBKT  &kp SQT   &kp DQT
&trans     &trans     &trans     &trans     &trans     &trans      &trans            &trans                                   &trans
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        /* 3: 右手テンキー＋演算子、左手 F1〜F12（かな ホールド）。エンコーダは音量 */
        num_layer {
            display-name = "Num";
            bindings = <
&trans  &kp F9  &kp F10  &kp F11  &kp F12                              &kp N7  &kp N8  &kp N9  &kp PLUS   &kp MINUS
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &trans      &trans          &kp N4  &kp N5  &kp N6  &kp STAR   &kp SLASH
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &trans      &trans          &kp N1  &kp N2  &kp N3  &kp EQUAL  &kp COLON
&trans  &trans  &trans   &trans   &trans   &trans      &trans          &kp N0                             &kp DOT
            >;

            sensor-bindings = <&encoder_volume>;
        };

        /* 4: 矢印・テンキー（Enter ホールド）。V3 と同じ。2026-10-27 に3段目 K を ↑→↓ に変更（本人指示） */
        arrow_layer {
            display-name = "Arrow";
            bindings = <
&kp ESC        &kp N7  &kp N8   &kp N9   &kp STAR                              &kp LPAR                  &kp LA(LEFT)  &kp UP    &kp RA(RIGHT)           &kp LBKT
&kp TAB        &kp N4  &kp N5   &kp N6   &kp RBKT   &trans  &trans             &kp BSLH                  &kp EXCL      &kp MINUS &kp QMARK               &kp RC(TAB)
&kp LEFT_SHIFT &kp N1  &kp N2   &kp N3   &trans     &trans  &trans             &kp LA(LG(LC(LEFT)))      &kp LEFT      &kp DOWN  &kp RIGHT               &kp RA(RC(RG(RIGHT)))
&trans         &trans  &kp N0   &trans   &trans     &trans  &trans             &kp BACKSPACE                                                             &trans
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };


        /* 5: マウス（ボールで自動）。J/K/L = 左/中/右クリック、; ホールドで SCROLL */
        mouse_layer {
            display-name = "Mouse";
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &mkp MB1  &mkp MB3  &mkp MB2  &mo SCROLL
&trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans                                &trans
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        /* 6: スクロール（MOUSE で ; ホールド）。J/L = アプリ切替、親指 = スクショ・Mission Control、右端 = CONFIG トグル */
        scroll_layer {
            display-name = "Scroll";
            bindings = <
&trans  &trans  &kp ENTER  &trans  &trans                                     &trans            &trans           &trans   &trans       &trans
&trans  &trans  &trans     &trans  &trans     &trans  &trans                  &trans            &kp LG(LS(TAB))  &trans   &kp LG(TAB)  &trans
&trans  &trans  &trans     &trans  &trans     &trans  &trans                  &trans            &trans           &trans   &trans       &trans
&trans  &trans  &trans     &trans  &kp LS(LG(N5))  &kp LS(LG(N4))      &kp LC(DOWN)  &kp LC(UP_ARROW)                                  &tog CONFIG
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        /* 7: 設定（SCROLL の右端キーでトグル。左下 Ctrl 位置か右端でもう一度押して抜ける）
         *    W = Windows 層トグル、O = USB/BLE 出力切替、Z〜B = BT 接続先 0〜4、N = ブートローダー */
        config_layer {
            display-name = "Config";
            bindings = <
&bt BT_CLR_ALL  &tog WIN      &trans        &trans        &trans                                &trans       &trans  &trans  &out OUT_TOG  &trans
&trans          &trans        &trans        &trans        &trans        &trans  &trans          &trans       &trans  &trans  &trans        &trans
&bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans  &trans          &bootloader  &trans  &trans  &trans        &trans
&tog CONFIG     &trans        &trans        &trans        &trans        &trans  &trans          &trans                                     &tog CONFIG
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        /* 8: WIN + ARROW で自動。単語移動 Ctrl+←→（U/O）、画面移動 Win+Shift+←→（N/_） */
        win_arrow_layer {
            display-name = "WinArrow";
            bindings = <
&trans  &trans  &trans  &trans  &trans                              &trans            &kp LC(LEFT)  &trans  &kp LC(RIGHT)  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans          &trans            &trans        &trans  &trans         &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans          &kp LG(LS(LEFT))  &trans        &trans  &trans         &kp LG(LS(RIGHT))
&trans  &trans  &trans  &trans  &trans  &trans      &trans          &trans                                                 &trans
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        /* 9: WIN + SCROLL で自動。アプリ切替 Alt+Tab、スクショ Win+Shift+S / PrintScreen、Win+D / Win+Tab */
        win_scroll_layer {
            display-name = "WinScroll";
            bindings = <
&trans  &trans  &trans  &trans  &trans                                     &trans      &trans               &trans  &trans        &trans
&trans  &trans  &trans  &trans  &trans         &trans        &trans        &trans      &kp LA(LS(TAB))      &trans  &kp LA(TAB)   &trans
&trans  &trans  &trans  &trans  &trans         &trans        &trans        &trans      &trans               &trans  &trans        &trans
&trans  &trans  &trans  &trans  &kp LG(LS(S))  &kp PSCRN                   &kp LG(D)   &kp LG(TAB)                                &trans
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };
    };
};
